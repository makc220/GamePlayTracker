@page "/games/delete"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення гри</PageTitle>

<h1>Видалення гри</h1>

@if (game is not null)
{
    <p>Ви впевнені, що хочете видалити гру «@game.Title»?</p>
}
<div>
    <h2>Інформація про гру</h2>
    <hr />
    @if (game is null)
    {
        <p><em>Завантаження...</em></p>
    }
    else {
     <GameCard Game="game"
          Caption="Ви видаляєте цю гру"
     ShowDetails="false" />
     
        <EditForm method="post" Model="game" OnValidSubmit="DeleteGame" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(game is null)">
            Видалити гру
            </button>
            <a href="/games" class="btn btn-secondary ms-2">Скасувати</a>
        </EditForm>
    }
</div>

@code {
    private Game? game;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        game = await context.Games.FirstOrDefaultAsync(m => m.Id == Id);

        if (game is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteGame()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Games.Remove(game!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/games");
    }
}
