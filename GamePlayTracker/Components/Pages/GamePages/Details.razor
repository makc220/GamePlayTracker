@page "/games/details"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Деталі гри</PageTitle>

<h1>Деталі гри</h1>

<div>
    <hr />
    @if (game is null)
    {
        <p><em>Завантаження...</em></p>
    }
    else {
      <GameCard Game="game" Caption="Подробиці гри" />
        <div>
            <a href="@($"/games/edit?id={game.Id}")">Редагування</a> |
            <a href="@($"/games")">Повернутися до списку ігор</a>
        </div>
    }
</div>

@code {
    private Game? game;

    [SupplyParameterFromQuery]
    private int Id { get; set; }


protected override async Task OnInitializedAsync()
{
    await using var context = await DbFactory.CreateDbContextAsync();

    game = await context.Games
        .Include(g => g.Genre)
        .Include(g => g.Platform)
        .FirstOrDefaultAsync(m => m.Id == Id);

    if (game is null)
    {
        NavigationManager.NotFound();
    }
}

}
