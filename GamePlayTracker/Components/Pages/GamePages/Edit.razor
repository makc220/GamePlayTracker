@page "/games/edit"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.Sqlite
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редагування гри</PageTitle>

<h1>Редагування гри</h1>
<hr />
@if (Game is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Game" OnValidSubmit="UpdateGame" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (error is not null)
                {
                    <div class="alert alert-danger">@error</div>
                } 
                <input type="hidden" name="Game.Id" value="@Game.Id" />
                <div class="mb-3">
                    <label for="title" class="form-label">Назва гри:</label>
                    <InputText id="title" @bind-Value="Game.Title" class="form-control" />
                    <ValidationMessage For="() => Game.Title" class="text-danger" />
                </div>
               <div class="mb-3">
                    <label for="genre" class="form-label">Жанр:</label>
                    <InputSelect id="genre" @bind-Value="Game.GenreId" class="form-select">
                        <option value="0">-- Оберіть жанр --</option>
                        @foreach (var genre in genres)
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Game.GenreId" class="text-danger" />
                </div>
                <div class="mb-3">
                <label for="platform" class="form-label">Платформа:</label>
                <InputSelect id="platform" @bind-Value="Game.PlatformId" class="form-select">
                    <option value="0">-- Оберіть платформу --</option>
                    @foreach (var platform in platforms)
                    {
                        <option value="@platform.Id">@platform.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Game.PlatformId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="developer" class="form-label">Розробник:</label>
                    <InputText id="developer" @bind-Value="Game.Developer" class="form-control" />
                    <ValidationMessage For="() => Game.Developer" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="releasedate" class="form-label">Дата виходу:</label>
                    <InputDate id="releasedate" @bind-Value="Game.ReleaseDate" class="form-control" />
                    <ValidationMessage For="() => Game.ReleaseDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="releaseyear" class="form-label">Рік випуску:</label>
                    <InputNumber id="releaseyear" @bind-Value="Game.ReleaseYear" class="form-control" />
                    <ValidationMessage For="() => Game.ReleaseYear" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Опис:</label>
                    <InputText id="description" @bind-Value="Game.Description" class="form-control" />
                    <ValidationMessage For="() => Game.Description" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Зберегти зміни</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/games">Повернутися до списку ігор</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }
    private List<Genre> genres = new();
    private List<Platform> platforms = new();
    [SupplyParameterFromForm]
    private Game? Game { get; set; }
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        Game ??= await context.Games.FirstOrDefaultAsync(m => m.Id == Id);
        genres = await context.Genres.OrderBy(g => g.Name).ToListAsync();
        platforms = await context.Platforms.OrderBy(p => p.Name).ToListAsync();

        if (Game is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
private async Task UpdateGame()
{
    if (Game is null)
    {
        return;
    }

    if (Game.ReleaseDate.Year != Game.ReleaseYear)
    {
        error = "Рік випуску має збігатися з роком у даті випуску";
        return;
    }

    error = null;

    await using var context = await DbFactory.CreateDbContextAsync();
    context.Attach(Game).State = EntityState.Modified;
    Game.TitleSearch = Game.Title.ToLowerInvariant();

    try
    {
        await context.SaveChangesAsync();
    }
    catch (DbUpdateConcurrencyException)
    {
        if (!await GameExistsAsync(Game.Id))
        {
            NavigationManager.NotFound();
        }
        else
        {
            throw;
        }
    }  
    catch (DbUpdateException ex)
        when (ex.InnerException is SqliteException
            { SqliteExtendedErrorCode: 2067 })
    {
        error = "Гра з такою назвою та роком випуску вже існує";
        return;
    }

        NavigationManager.NavigateTo("/games?saved=true");
}

    private async Task<bool> GameExistsAsync(int id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        return await context.Games.AnyAsync(e => e.Id == id);
    }
}
