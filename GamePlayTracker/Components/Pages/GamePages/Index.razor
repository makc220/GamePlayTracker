@page "/games"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using GamePlayTracker.Models
@using GamePlayTracker.Data
@inject IDbContextFactory<GamePlayTrackerContext> DbFactory

<PageTitle>Список ігор</PageTitle>

<h1>Список ігор</h1>

<p>
    <a href="games/create">Створити нову гру</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="search"
               value="@Search"
               class="form-control"
               placeholder="Пошук за назвою" />
    </div>

    <div class="col-md-3">
        <select name="genreId" class="form-select">
            <option value="">Усі жанри</option>
            @foreach (var genre in genres)
            {
                <option value="@genre.Id" selected="@(GenreId == genre.Id)">
                    @genre.Name
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <select name="sort" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(Sort))">За назвою</option>
            <option value="year" selected="@(Sort == "year")">За роком випуску</option>
            <option value="date" selected="@(Sort == "date")">За датою виходу</option>
        </select>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Застосувати</button>
    </div>
</form>

<QuickGrid Class="table"
           Items="@games.Skip((CurrentPage - 1) * PageSize).Take(PageSize).AsQueryable()">
    <PropertyColumn Property="game => game.Title" Title="Назва" />
    <PropertyColumn Property="game => game.Genre!.Name" Title="Жанр" />
    <PropertyColumn Property="game => game.Platform!.Name" Title="Платформа" />
    <PropertyColumn Property="game => game.Developer" Title="Розробник" />
    <PropertyColumn Property="game => game.ReleaseDate" Title="Дата виходу" />
    <PropertyColumn Property="game => game.ReleaseYear" Title="Рік випуску" />
    <PropertyColumn Property="game => game.Description" Title="Опис" />

    <TemplateColumn>
        <ChildContent Context="game">
            <a href="@($"games/edit?id={game.Id}")">Редагувати</a> |
            <a href="@($"games/details?id={game.Id}")">Деталі</a> |
            <a href="@($"games/delete?id={game.Id}")">Видалити</a>
        </ChildContent>
    </TemplateColumn>
</QuickGrid>

@if (games.Count == 0)
{
    <p>Ігор за заданими умовами не знайдено.</p>
}
else
{
    <nav class="mt-3" aria-label="Навігація сторінками">
        @if (CurrentPage > 1)
        {
            <a class="btn btn-outline-primary me-2"
               href="@BuildPageUrl(CurrentPage - 1)">Назад</a>
        }

        <span>Сторінка @CurrentPage з @TotalPages</span>

        @if (CurrentPage < TotalPages)
        {
            <a class="btn btn-outline-primary ms-2"
               href="@BuildPageUrl(CurrentPage + 1)">Далі</a>
        }
    </nav>
}

@code {
    private const int PageSize = 10;

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "genreId")]
    public int? GenreId { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    private int CurrentPage => Page is > 0 ? Page.Value : 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(games.Count / (double)PageSize));

    private List<Game> games = new();
    private List<Genre> genres = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        await using var db = await DbFactory.CreateDbContextAsync();
        genres = await db.Genres.OrderBy(g => g.Name).ToListAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Games
            .Include(g => g.Genre)
            .Include(g => g.Platform)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(Search))
        {
            var search = Search.Trim().ToLowerInvariant();
            query = query.Where(g => g.TitleSearch.Contains(search));
        }

        if (GenreId is int genreId)
        {
            query = query.Where(g => g.GenreId == genreId);
        }

        query = Sort switch
        {
            "year" => query.OrderByDescending(g => g.ReleaseYear),
            "date" => query.OrderByDescending(g => g.ReleaseDate),
            _ => query.OrderBy(g => g.Title)
        };

        games = await query.ToListAsync();
    }

    private string BuildPageUrl(int page)
    {
        var search = Uri.EscapeDataString(Search ?? string.Empty);
        var genre = GenreId?.ToString() ?? string.Empty;
        var sort = Uri.EscapeDataString(Sort ?? string.Empty);

        return $"/games?page={page}&search={search}&genreId={genre}&sort={sort}";
    }
}
