@page "/genres/create"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Додавання жанру</PageTitle>

<h1>Додавання жанру</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Genre" OnValidSubmit="AddGenre" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="name" class="form-label">Назва жанру:</label>
                <InputText id="name" @bind-Value="Genre.Name" class="form-control" aria-required="true"/>
                <ValidationMessage For="() => Genre.Name" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Додати жанр</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/genres">Повернутися до списку жанрів</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Genre Genre { get; set; } = default!;

    protected override void OnInitialized() => Genre ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddGenre()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Genres.Add(Genre);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/genres");
    }
}
