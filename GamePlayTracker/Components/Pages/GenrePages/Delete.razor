@page "/genres/delete"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення жанру</PageTitle>

<h1>Видалення жанру</h1>

@if (genre is not null)
{
    <p>Ви впевнені, що хочете видалити жанр «@genre.Name»?</p>
}
<div>
    <h2>Інформація про жанр</h2>
    <hr />
    @if (genre is null)
    {
        <p><em>Завантаження...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Назва жанру</dt>
            <dd class="col-sm-10">@genre.Name</dd>
        </dl>
    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }
        <EditForm method="post" Model="genre" OnValidSubmit="DeleteGenre" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(genre is null)">Видалити жанр</button> |
            <a href="/genres">Повернутись до списку жанрів</a>
        </EditForm>
    }
</div>

@code {
    private Genre? genre;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        genre = await context.Genres.FirstOrDefaultAsync(m => m.Id == Id);

        if (genre is null)
        {
            NavigationManager.NotFound();
        }
    }

private string? error;

private async Task DeleteGenre()
{
    if (genre is null)
    {
        return;
    }

    await using var context = await DbFactory.CreateDbContextAsync();

    try
    {
        context.Genres.Remove(genre);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/genres");
    }
    catch (DbUpdateException)
    {
        error = "Не вдалося видалити жанр. Можливо, він використовується в одній або кількох іграх.";
    }
}
}
