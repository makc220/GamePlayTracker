@page "/genres/edit"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редагування жанру</PageTitle>

<h1>Редагування жанру</h1>

<hr />
@if (Genre is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Genre" OnValidSubmit="UpdateGenre" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Genre.Id" value="@Genre.Id" />
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="name" class="form-label">Назва жанру:</label>
                    <InputText id="name" @bind-Value="Genre.Name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Genre.Name" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Зберегти зміни</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/genres">Повернутись до списку жанрів</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Genre? Genre { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        Genre ??= await context.Genres.FirstOrDefaultAsync(m => m.Id == Id);

        if (Genre is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateGenre()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Attach(Genre!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
           if (!await GenreExistsAsync(Genre!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/genres");
    }

    private async Task<bool> GenreExistsAsync(int id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        return await context.Genres.AnyAsync(e => e.Id == id);
    }
}
