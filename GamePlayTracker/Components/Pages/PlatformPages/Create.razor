@page "/platforms/create"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Додати платформу</PageTitle>

<h1>Додати платформу</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Platform" OnValidSubmit="AddPlatform" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="name" class="form-label">Назва платформи:</label>
                <InputText id="name" @bind-Value="Platform.Name" class="form-control" aria-required="true"/>
                <ValidationMessage For="() => Platform.Name" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Додати платформу</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/platforms">Повернутися до списку платформ</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Platform Platform { get; set; } = default!;

    protected override void OnInitialized() => Platform ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddPlatform()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Platforms.Add(Platform);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/platforms");
    }
}
