@page "/platforms/delete"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення платформи</PageTitle>

<h1>Видалення платформи</h1>

@if (platform is not null)
{
    <p>Ви впевнені, що хочете видалити платформу «@platform.Name»?</p>
}
<div>
    <h2>Інформація про платформу</h2>
    <hr />
    @if (platform is null)
    {
        <p><em>Завантаження...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Назва платформи</dt>
            <dd class="col-sm-10">@platform.Name</dd>
        </dl>
        @if (error is not null)
        {
             <div class="alert alert-danger">@error</div>
        }
        <EditForm method="post" Model="platform" OnValidSubmit="DeletePlatform" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(platform is null)">Видалити платформу</button> |
            <a href="/platforms">Повернутись до списку платформ</a>
        </EditForm>
    }
</div>

@code {
    private Platform? platform;
    private string? error;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        platform = await context.Platforms.FirstOrDefaultAsync(m => m.Id == Id);

        if (platform is null)
        {
            NavigationManager.NotFound();
        }
    }

private async Task DeletePlatform()
{
    if (platform is null)
    {
        return;
    }

    await using var context = await DbFactory.CreateDbContextAsync();

    try
    {
        context.Platforms.Remove(platform);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/platforms");
    }
    catch (DbUpdateException)
    {
        error = "Не вдалося видалити платформу. Можливо, вона використовується в одній або кількох іграх.";
    }
}
}
