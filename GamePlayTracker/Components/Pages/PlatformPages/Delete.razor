@page "/platforms/delete"
@using Microsoft.EntityFrameworkCore
@using GamePlayTracker.Models
@inject IDbContextFactory<GamePlayTracker.Data.GamePlayTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Platform</h2>
    <hr />
    @if (platform is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@platform.Name</dd>
        </dl>
        @if (error is not null)
        {
             <div class="alert alert-danger">@error</div>
        }
        <EditForm method="post" Model="platform" OnValidSubmit="DeletePlatform" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(platform is null)">Delete</button> |
            <a href="/platforms">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Platform? platform;
    private string? error;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        platform = await context.Platforms.FirstOrDefaultAsync(m => m.Id == Id);

        if (platform is null)
        {
            NavigationManager.NotFound();
        }
    }

private async Task DeletePlatform()
{
    if (platform is null)
    {
        return;
    }

    using var context = DbFactory.CreateDbContext();

    try
    {
        context.Platforms.Remove(platform);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/platforms");
    }
    catch (DbUpdateException)
    {
        error = "Не вдалося видалити платформу. Можливо, вона використовується в одній або кількох іграх.";
    }
}
}
